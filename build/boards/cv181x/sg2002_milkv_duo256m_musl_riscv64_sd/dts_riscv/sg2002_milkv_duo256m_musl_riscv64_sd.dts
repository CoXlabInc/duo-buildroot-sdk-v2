/dts-v1/;
#include "cv181x_base_riscv.dtsi"
#include "cv181x_asic_qfn.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo256M";
};

&mipi_rx {
	snsr-reset = <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&spi2 {
	status = "disabled";

	/delete-node/ spidev@0;

	spi-sram@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "microchip,mchp23lcv1024";
		reg = <0>;
		spi-max-frequency = <20000000>;
	};
};

&dac {
	mute-gpio-r = <&porte 1 GPIO_ACTIVE_LOW>;
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&wifisd {
	cap-sd-highspeed;
	cap-mmc-highspeed;
	non-removable;
	disable-wp;
	cap-sdio-irq;

	status = "okay";

	mm6108_sdio: mm6108_sdio@0 {
		compatible = "morse,mm610x";
		reset-gpios = <&porta 22 GPIO_ACTIVE_LOW>;
		power-gpios = <&porta 24 GPIO_ACTIVE_HIGH>, <&porta 23 GPIO_ACTIVE_HIGH>;
		status = "okay";
		reg = <2>;
		bus-width = <4>;
	};
};

&wifi_pin {
	compatible = "cvitek,wifi-pin";
/*	poweron-gpio = <&porta 22 GPIO_ACTIVE_LOW>;*/
	wakeup-gpio = <&porta 24 GPIO_ACTIVE_HIGH>;
};
